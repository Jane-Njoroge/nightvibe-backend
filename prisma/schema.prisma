generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model audit_logs {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String?  @db.Uuid
  action      String   @db.VarChar(100)
  entity      String   @db.VarChar(100)
  entity_id   String?  @db.Uuid
  description String?
  ip_address  String?  @db.VarChar(50)
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  users       users?   @relation(fields: [user_id], references: [id], onUpdate: NoAction)

  @@index([entity, entity_id], map: "idx_audit_entity")
}

model booking_tables {
  booking_id  String      @db.Uuid
  table_id    String      @db.Uuid
  bookings    bookings    @relation(fields: [booking_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  club_tables club_tables @relation(fields: [table_id], references: [id], onUpdate: NoAction)

  @@id([booking_id, table_id])
}

model bookings {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id          String           @db.Uuid
  event_id         String           @db.Uuid
  status           booking_status   @default(PENDING)
  guest_count      Int              @default(1)
  special_requests String?
  total_amount     Decimal          @default(0) @db.Decimal(10, 2)
  created_at       DateTime         @default(now()) @db.Timestamptz(6)
  updated_at       DateTime         @default(now()) @db.Timestamptz(6)
  booking_tables   booking_tables[]
  events           events           @relation(fields: [event_id], references: [id], onUpdate: NoAction)
  users            users            @relation(fields: [user_id], references: [id], onUpdate: NoAction)
  payments         payments[]
  tickets          tickets[]

  @@index([event_id], map: "idx_bookings_event")
  @@index([status], map: "idx_bookings_status")
  @@index([user_id], map: "idx_bookings_user")
}

model club_tables {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  table_number   String           @unique @db.VarChar(20)
  section        String?          @db.VarChar(100)
  capacity       Int
  min_spend      Decimal          @default(0) @db.Decimal(10, 2)
  status         table_status     @default(AVAILABLE)
  created_at     DateTime         @default(now()) @db.Timestamptz(6)
  booking_tables booking_tables[]
}

model djs {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String          @db.VarChar(150)
  bio           String?
  photo_url     String?
  instagram     String?         @db.VarChar(100)
  soundcloud    String?         @db.VarChar(150)
  is_active     Boolean         @default(true)
  created_at    DateTime        @default(now()) @db.Timestamptz(6)
  event_lineups event_lineups[]
}

model event_lineups {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  event_id          String    @db.Uuid
  dj_id             String    @db.Uuid
  performance_order Int       @default(1)
  start_time        DateTime? @db.Time(6)
  end_time          DateTime? @db.Time(6)
  djs               djs       @relation(fields: [dj_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  events            events    @relation(fields: [event_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([event_id, dj_id])
}

model events {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  venue_id      String          @db.Uuid
  title         String          @db.VarChar(200)
  description   String?
  event_date    DateTime        @db.Date
  start_time    DateTime        @db.Time(6)
  end_time      DateTime?       @db.Time(6)
  poster_url    String?
  ticket_price  Decimal         @default(0) @db.Decimal(10, 2)
  capacity      Int
  status        event_status    @default(DRAFT)
  created_by    String          @db.Uuid
  created_at    DateTime        @default(now()) @db.Timestamptz(6)
  updated_at    DateTime        @default(now()) @db.Timestamptz(6)
  bookings      bookings[]
  event_lineups event_lineups[]
  users         users           @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  venues        venues          @relation(fields: [venue_id], references: [id], onUpdate: NoAction)
  media         media[]

  @@index([event_date], map: "idx_events_date")
  @@index([status], map: "idx_events_status")
}

model media {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  event_id    String?    @db.Uuid
  url         String
  caption     String?    @db.VarChar(300)
  media_type  media_type @default(IMAGE)
  uploaded_by String     @db.Uuid
  created_at  DateTime   @default(now()) @db.Timestamptz(6)
  events      events?    @relation(fields: [event_id], references: [id], onUpdate: NoAction)
  users       users      @relation(fields: [uploaded_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([event_id], map: "idx_media_event")
}

model notifications {
  id         String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String            @db.Uuid
  type       notification_type
  message    String
  is_read    Boolean           @default(false)
  created_at DateTime          @default(now()) @db.Timestamptz(6)
  users      users             @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "idx_notifs_user")
}

model payments {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  booking_id      String         @db.Uuid
  amount          Decimal        @db.Decimal(10, 2)
  currency        String         @default("KES") @db.VarChar(10)
  method          payment_method
  status          payment_status @default(PENDING)
  transaction_ref String?        @db.VarChar(255)
  gateway_ref     String?        @db.VarChar(255)
  paid_at         DateTime?      @db.Timestamptz(6)
  created_at      DateTime       @default(now()) @db.Timestamptz(6)
  updated_at      DateTime       @default(now()) @db.Timestamptz(6)
  bookings        bookings       @relation(fields: [booking_id], references: [id], onUpdate: NoAction)

  @@index([booking_id], map: "idx_payments_booking")
  @@index([status], map: "idx_payments_status")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model promotions {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title          String   @db.VarChar(200)
  description    String?
  code           String?  @unique @db.VarChar(50)
  discount_type  String   @db.VarChar(20)
  discount_value Decimal  @db.Decimal(10, 2)
  valid_from     DateTime @db.Timestamptz(6)
  valid_to       DateTime @db.Timestamptz(6)
  max_uses       Int?
  use_count      Int      @default(0)
  is_active      Boolean  @default(true)
  created_at     DateTime @default(now()) @db.Timestamptz(6)
}

model tickets {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  booking_id  String   @db.Uuid
  ticket_type String   @default("GENERAL") @db.VarChar(100)
  quantity    Int      @default(1)
  unit_price  Decimal  @db.Decimal(10, 2)
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  bookings    bookings @relation(fields: [booking_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model users {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String          @unique @db.VarChar(255)
  password_hash String          @db.VarChar(255)
  first_name    String          @db.VarChar(100)
  last_name     String          @db.VarChar(100)
  phone         String?         @db.VarChar(20)
  role          user_role       @default(CUSTOMER)
  is_active     Boolean         @default(true)
  created_at    DateTime        @default(now()) @db.Timestamptz(6)
  updated_at    DateTime        @default(now()) @db.Timestamptz(6)
  audit_logs    audit_logs[]
  bookings      bookings[]
  events        events[]
  media         media[]
  notifications notifications[]
}

model venues {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @db.VarChar(100)
  description String?
  address     String
  city        String   @default("Nairobi") @db.VarChar(100)
  capacity    Int
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  events      events[]
}

enum booking_status {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum event_status {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum media_type {
  IMAGE
  VIDEO
}

enum notification_type {
  BOOKING_CONFIRMED
  BOOKING_CANCELLED
  PAYMENT_SUCCESS
  PAYMENT_FAILED
  EVENT_REMINDER
  GENERAL
}

enum payment_method {
  MPESA
  STRIPE
  CASH
}

enum payment_status {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum table_status {
  AVAILABLE
  RESERVED
  MAINTENANCE
}

enum user_role {
  CUSTOMER
  STAFF
  ADMIN
}
